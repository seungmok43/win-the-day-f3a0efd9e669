// Firestore 보안 규칙 — Win the Day (제안본 · 2026-08-06)
//
// ⚠ 이 파일은 **제안**이다. 사업국은 Firebase 콘솔을 변경하지 않았다(본부 HARD STOP).
//    오너가 콘솔 → Firestore Database → 규칙 에 붙여넣고 [게시]해야 적용된다.
//
// ★배경: 이 앱은 로그인(Firebase Auth)이 없다. 따라서 서버가 "누가 썼는지"를
//    검증할 수 없고, 규칙으로 할 수 있는 것은 **형태 검증과 최소 권한**뿐이다.
//    아래 규칙은 현행 앱이 실제로 하는 동작만 허용하고 나머지를 막는다.
//
// ★적용 전 반드시 확인할 것 (적용하면 앱이 깨질 수 있는 지점):
//    1. 신규 collection 'reports' 쓰기 허용이 들어 있어야 신고 기능이 동작한다.
//    2. 삭제 허용 범위 — 현행 앱은 클라이언트에서 본인·관리자 판정을 하므로
//       규칙 단에서는 삭제를 열어둘 수밖에 없다(로그인 도입 전까지의 한계).
//       ⇒ 로그인 도입이 근본 해결책이다. 그 전까지는 이 한계를 인지하고 운영한다.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── 묵상 ──────────────────────────────────────────────
    match /meditations/{postId} {
      allow read: if true;

      // 생성: 필수 필드가 있고, 길이 상한을 넘지 않을 것
      allow create: if request.resource.data.keys().hasAll(['name', 'date', 'timestamp'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 20
                    && request.resource.data.date is string
                    && (!('church' in request.resource.data)
                        || request.resource.data.church == null
                        || request.resource.data.church.size() <= 30)
                    && (!('content' in request.resource.data)
                        || request.resource.data.content == null
                        || request.resource.data.content.size() <= 5000);

      // 수정: 좋아요 카운터만 (본문 위변조 차단)
      allow update: if request.resource.data.diff(resource.data)
                      .affectedKeys().hasOnly(['likes'])
                    && request.resource.data.likes is int
                    && request.resource.data.likes >= 0;

      // 삭제: 로그인이 없어 서버가 소유자를 검증할 수 없다(위 주석 참고)
      allow delete: if true;

      // ── 댓글 ──
      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasAll(['name', 'text', 'timestamp'])
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 100
                      && request.resource.data.name.size() <= 20;
        allow update: if false;   // 댓글 수정 기능 없음
        allow delete: if true;    // 위와 같은 한계
      }
    }

    // ── 신고 (심사지침 1.2 — 운영자 검토 큐) ────────────────
    // ★쓰기만 허용하고 읽기는 막는다. 신고 내역은 운영자가
    //   Firebase 콘솔에서 직접 본다(다른 사용자가 열람하면 2차 피해).
    match /reports/{reportId} {
      allow read:   if false;
      allow create: if request.resource.data.keys().hasAll(['targetType', 'reason', 'resolved'])
                    && request.resource.data.targetType in ['post', 'comment']
                    && request.resource.data.reason is string
                    && request.resource.data.reason.size() <= 100
                    && request.resource.data.resolved == false
                    && (!('excerpt' in request.resource.data)
                        || request.resource.data.excerpt.size() <= 200);
      allow update, delete: if false;   // 처리는 콘솔에서만
    }

    // ── 그 밖의 모든 경로는 금지 ─────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
